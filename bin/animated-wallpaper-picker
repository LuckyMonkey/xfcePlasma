#!/usr/bin/env bash
set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -r "$script_dir/../lib/xfce-plasma-common.sh" ]; then
    # shellcheck source=../lib/xfce-plasma-common.sh
    . "$script_dir/../lib/xfce-plasma-common.sh"
else
    # shellcheck source=/dev/null
    . "${XFCE_PLASMA_COMMON:-$HOME/.local/lib/xfce-plasma/xfce-plasma-common.sh}"
fi

RUNTIME=${WALLPAPER_RUNTIME:-$HOME/.local/lib/tie-dye-wallpaper}
SHADER_DIR=${WALLPAPER_SHADER_DIR:-$RUNTIME/shaders}
USER_SHADER_DIR=${WALLPAPER_USER_SHADER_DIR:-$XFCE_PLASMA_USER_SHADER_DIR}
ACTIVE_SHADER=${WALLPAPER_ACTIVE_SHADER:-$RUNTIME/shader.fs}
STATE_DIR=${WALLPAPER_STATE_DIR:-$XFCE_PLASMA_RENDERER_COMPAT_STATE_DIR}
STATE_FILE=$STATE_DIR/current-shader
THUMBNAIL_DIR=${WALLPAPER_THUMBNAIL_DIR:-$XFCE_PLASMA_DATA_DIR/assets/thumbnails}
FALLBACK_THUMBNAIL=${WALLPAPER_FALLBACK_THUMBNAIL:-$THUMBNAIL_DIR/fallback.png}

ORDER=(
    plasma.fs
    tie-dye.fs
    motion-halftone.fs
    qr-cube-maze.fs
    sky-water-wave.fs
    kaleidoscope-tunnel.fs
    aurora-ribbons.fs
    plasma-lava.fs
    red-forest.fs
    boku-city.fs
    ricky.fs
    hello-kitty-dancefloor.fs
    grime-signal.fs
)

label_for() {
    case "$1" in
        plasma.fs|tie-dye.fs) printf 'Plasma';;
        motion-halftone.fs) printf 'Motion Halftone';;
        qr-cube-maze.fs) printf 'QR Cube Maze';;
        sky-water-wave.fs) printf 'Sky Water Wave';;
        kaleidoscope-tunnel.fs) printf 'Kaleidoscope Tunnel';;
        aurora-ribbons.fs) printf 'Aurora Ribbons';;
        plasma-lava.fs) printf 'Plasma Lava';;
        red-forest.fs) printf 'Red Forest';;
        boku-city.fs) printf 'Boku City';;
        ricky.fs) printf 'Ricky';;
        hello-kitty-dancefloor.fs) printf 'Hello Kitty Dancefloor';;
        grime-signal.fs) printf 'Grime Signal';;
        *) basename "$1" .fs | sed 's/-/ /g; s/\b\(.\)/\u\1/g';;
    esac
}

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "Animated wallpaper" "$1" >/dev/null 2>&1 || true
}

valid_shader_name() {
    case "$1" in
        ''|*/*|.|..|[.-]*|*[!A-Za-z0-9._\ -]*|*.fs.fs) return 1;;
        *.fs) return 0;;
        *) return 1;;
    esac
}

shader_path() {
    local name=$1
    valid_shader_name "$name" || return 1
    if [ -f "$SHADER_DIR/$name" ]; then
        printf '%s\n' "$SHADER_DIR/$name"
    elif [ -f "$USER_SHADER_DIR/$name" ]; then
        printf '%s\n' "$USER_SHADER_DIR/$name"
    else
        return 1
    fi
}

shader_origin() {
    local name=$1
    valid_shader_name "$name" || return 1
    if [ -f "$SHADER_DIR/$name" ]; then printf 'bundled\n'
    elif [ -f "$USER_SHADER_DIR/$name" ]; then printf 'local\n'
    else return 1
    fi
}

shader_metadata_path() {
    local name=$1 base=${1%.fs}
    if [ -f "$SHADER_DIR/$name" ]; then printf '%s/%s.meta\n' "$SHADER_DIR" "$base"
    elif [ -f "$USER_SHADER_DIR/$name" ]; then printf '%s/%s.meta\n' "$USER_SHADER_DIR" "$base"
    else return 1
    fi
}

metadata_value() {
    local file=$1 key=$2 fallback=$3 value
    value=$(xfce_plasma_config_get "$file" "$key" 2>/dev/null || true)
    if [ -n "$value" ]; then printf '%s\n' "$value"; else printf '%s\n' "$fallback"; fi
}

is_hidden_shader() {
    local meta
    meta=$(shader_metadata_path "$1" 2>/dev/null || true)
    [ "$(metadata_value "$meta" hidden false)" != true ]
}

clean_field() {
    printf '%s' "$1" | tr '\t\r\n' '   '
}

editable_shader_path() {
    valid_shader_name "$1" || {
        printf 'Invalid shader name: %s\n' "$1" >&2
        return 1
    }
    shader_path "$1" || {
        printf 'Shader not found: %s\n' "$1" >&2
        return 1
    }
}

is_ordered() {
    local name=$1 item
    for item in "${ORDER[@]}"; do
        [ "$item" = "$name" ] && return 0
    done
    return 1
}

canonical_shader_name() {
    case "${1,,}" in
        tie-dye|tie-dye.fs|'tie dye')
            if [ -f "$SHADER_DIR/plasma.fs" ]; then printf 'plasma.fs\n'; else printf 'tie-dye.fs\n'; fi;;
        plasma|plasma.fs) printf 'plasma.fs\n';;
        *) printf '%s\n' "$1";;
    esac
}

available() {
    local name
    for name in "${ORDER[@]}"; do
        [ "$name" != tie-dye.fs ] || [ ! -f "$SHADER_DIR/plasma.fs" ] || continue
        is_hidden_shader "$name" || continue
        shader_path "$name" >/dev/null 2>&1 && printf '%s\n' "$name"
    done
    {
        local directory
        for directory in "$SHADER_DIR" "$USER_SHADER_DIR"; do
            [ ! -d "$directory" ] || find "$directory" -maxdepth 1 -type f -name '*.fs' -printf '%f\n'
        done
        true
    } 2>/dev/null | sort -u | while IFS= read -r name; do
        [ "$name" != tie-dye.fs ] || [ ! -f "$SHADER_DIR/plasma.fs" ] || continue
        is_hidden_shader "$name" || continue
        is_ordered "$name" || printf '%s\n' "$name"
    done
}

catalog() {
    local name path origin meta default_id shader_id display category description author thumbnail order meta_dir
    while IFS= read -r name; do
        path=$(shader_path "$name")
        origin=$(shader_origin "$name")
        meta=$(shader_metadata_path "$name")
        default_id=${name%.fs}
        shader_id=$(metadata_value "$meta" id "$default_id")
        case "$shader_id" in ''|*[!A-Za-z0-9_-]*) shader_id=$default_id ;; esac
        display=$(metadata_value "$meta" display_name "$(label_for "$name")")
        category=$(metadata_value "$meta" category Experimental)
        if [ "$origin" = local ]; then
            description=$(metadata_value "$meta" description "User shader without bundled metadata.")
            author=$(metadata_value "$meta" author User)
            order=$(metadata_value "$meta" sort_order 9000)
        else
            description=$(metadata_value "$meta" description "Bundled shader without metadata.")
            author=$(metadata_value "$meta" author xfcePlasma)
            order=$(metadata_value "$meta" sort_order 8000)
        fi
        case "$order" in ''|*[!0-9]*) order=9999 ;; esac
        thumbnail=$(metadata_value "$meta" thumbnail "$shader_id.png")
        meta_dir=$(dirname "$path")
        case "$thumbnail" in
            /*) [ -r "$thumbnail" ] || thumbnail=$FALLBACK_THUMBNAIL ;;
            *)
                if [ -r "$meta_dir/$thumbnail" ]; then thumbnail=$meta_dir/$thumbnail
                elif [ -r "$THUMBNAIL_DIR/$thumbnail" ]; then thumbnail=$THUMBNAIL_DIR/$thumbnail
                else thumbnail=$FALLBACK_THUMBNAIL
                fi ;;
        esac
        printf '%09d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$order" \
            "$(clean_field "$name")" "$(clean_field "$shader_id")" "$(clean_field "$display")" \
            "$(clean_field "$category")" "$(clean_field "$description")" "$(clean_field "$author")" \
            "$(clean_field "$thumbnail")" "$origin" "$order"
    done < <(available) | LC_ALL=C sort -t $'\t' -k1,1n -k4,4 | cut -f2-
}

current() {
    local saved active_hash name shader_hash source
    if [ -s "$STATE_FILE" ]; then
        saved=$(cat "$STATE_FILE")
        saved=$(canonical_shader_name "$saved")
        if shader_path "$saved" >/dev/null 2>&1; then
            printf '%s\n' "$saved"
            return
        fi
    fi

    if [ -f "$SHADER_DIR/plasma.fs" ] &&
       { cmp -s "$ACTIVE_SHADER" "$SHADER_DIR/plasma.fs" 2>/dev/null ||
         cmp -s "$ACTIVE_SHADER" "$SHADER_DIR/tie-dye.fs" 2>/dev/null; }; then
        printf 'plasma.fs\n'
        return
    fi
    if cmp -s "$ACTIVE_SHADER" "$SHADER_DIR/tie-dye.fs" 2>/dev/null; then
        printf 'tie-dye.fs\n'
        return
    fi

    active_hash=$(sha256sum "$ACTIVE_SHADER" 2>/dev/null | awk '{print $1}' || true)
    while IFS= read -r name; do
        source=$(shader_path "$name" || true)
        shader_hash=$(sha256sum "$source" 2>/dev/null | awk '{print $1}' || true)
        if [ -n "$active_hash" ] && [ "$active_hash" = "$shader_hash" ]; then
            printf '%s\n' "$name"
            return
        fi
    done < <(available)
    available | head -n 1
}

select_relative() {
    local direction=$1 cur count index i name
    local shaders=()
    cur=$(current)
    while IFS= read -r name; do shaders+=("$name"); done < <(available)
    count=${#shaders[@]}
    [ "$count" -gt 0 ] || exit 1
    index=0
    for i in "${!shaders[@]}"; do
        [ "${shaders[$i]}" = "$cur" ] && index=$i
    done
    if [ "$direction" = next ]; then
        index=$(( (index + 1) % count ))
    else
        index=$(( index - 1 ))
        [ "$index" -ge 0 ] || index=$((count - 1))
    fi
    printf '%s\n' "${shaders[$index]}"
}

choose_gui() {
    local cur name label active
    local rows=()
    cur=$(current)
    while IFS= read -r name; do
        label=$(label_for "$name")
        if [ "$name" = "$cur" ]; then active=TRUE; else active=FALSE; fi
        rows+=("$active" "$label" "$name")
    done < <(available)
    if command -v zenity >/dev/null 2>&1; then
        zenity --list --radiolist --title="Animated wallpaper" --text="Choose wallpaper" \
            --column="" --column="Wallpaper" --column="File" --hide-column=3 --print-column=3 \
            "${rows[@]}" 2>/dev/null
    elif command -v rofi >/dev/null 2>&1; then
        available | while IFS= read -r name; do label_for "$name"; printf '\t%s\n' "$name"; done |
            rofi -dmenu -p "Wallpaper" | awk -F '\t' '{print $2}'
    else
        available
    fi
}

apply_shader() {
    local name=$1 src id selector
    name=$(canonical_shader_name "$name")
    src=$(shader_path "$name" || true)
    [ -f "$src" ] || { notify "Missing shader: $name"; return 1; }
    xfce_plasma_mkdirs
    mkdir -p "$STATE_DIR" "$(dirname "$ACTIVE_SHADER")"
    xfce_plasma_atomic_copy "$src" "$ACTIVE_SHADER"
    xfce_plasma_atomic_write "$STATE_FILE" "$name"
    id=${name%.fs}
    case "$id" in
        ''|[.-]*|*[!A-Za-z0-9._-]*) ;;
        *)
            selector=$(printf 'type=shader\nid=%s\n' "$id")
            xfce_plasma_atomic_write "$XFCE_PLASMA_ACTIVE_SOURCE_FILE" "$selector"
            ;;
    esac
    notify "$(label_for "$name")"
}

user_add() {
    local src=$1 name
    [ -f "$src" ] || { printf 'Shader file not found: %s\n' "$src" >&2; return 1; }
    name=$(basename "$src")
    valid_shader_name "$name" || { printf 'Shader must use a safe .fs filename\n' >&2; return 1; }
    [ ! -e "$SHADER_DIR/$name" ] || { printf 'Built-in shader already exists: %s\n' "$name" >&2; return 1; }
    xfce_plasma_atomic_copy "$src" "$USER_SHADER_DIR/$name"
    printf '%s\n' "$name"
}

create_shader() {
    local name=$1 template=${2:-plasma.fs} source
    template=$(canonical_shader_name "$template")
    valid_shader_name "$name" || { printf 'Use a simple filename ending in .fs\n' >&2; return 1; }
    [ ! -e "$SHADER_DIR/$name" ] && [ ! -e "$USER_SHADER_DIR/$name" ] || {
        printf 'Shader already exists: %s\n' "$name" >&2; return 1
    }
    source=$(shader_path "$template" || true)
    [ -f "$source" ] || { printf 'Template shader not found: %s\n' "$template" >&2; return 1; }
    xfce_plasma_atomic_copy "$source" "$USER_SHADER_DIR/$name"
    printf '%s\n' "$name"
}

replace_shader() {
    local name=$1 source=$2 destination selected
    [ -f "$source" ] || { printf 'Shader source not found: %s\n' "$source" >&2; return 1; }
    destination=$(editable_shader_path "$name")
    xfce_plasma_atomic_copy "$source" "$destination"
    selected=$(current)
    if [ "$selected" = "$name" ]; then xfce_plasma_atomic_copy "$destination" "$ACTIVE_SHADER"; fi
    printf '%s\n' "$name"
}

remove_shader() {
    local name=$1 path selected replacement count
    path=$(editable_shader_path "$name")
    case "$path" in
        "$USER_SHADER_DIR"/*) ;;
        *) printf 'Bundled shaders cannot be deleted; duplicate it to create a local copy.\n' >&2; return 1 ;;
    esac
    count=$(available | wc -l)
    [ "$count" -gt 1 ] || { printf 'The last shader cannot be removed\n' >&2; return 1; }
    selected=$(current)
    if [ "$selected" = "$name" ]; then
        replacement=$(select_relative next)
        [ "$replacement" != "$name" ] || return 1
        apply_shader "$replacement"
    fi
    rm -f -- "$path" "${path%.fs}.meta"
    printf '%s\n' "$name"
}

read_shader() {
    local path
    path=$(editable_shader_path "$1")
    cat -- "$path"
}

case "${1:-pick}" in
    next|--next) choice=$(select_relative next);;
    prev|previous|--prev|--previous) choice=$(select_relative prev);;
    set|--set) shift; choice=${1:-};;
    list|--list) available; exit 0;;
    catalog|--catalog) catalog; exit 0;;
    current|--current) current; exit 0;;
    status|--status) systemctl --user is-active tie-dye-wallpaper-mvp.service 2>/dev/null || printf 'inactive\n'; exit 0;;
    origin|--origin) shift; shader_origin "${1:-}"; exit $?;;
    source|--source) shift; editable_shader_path "${1:-}"; exit $?;;
    read|--read) shift; read_shader "${1:-}"; exit $?;;
    user-add|--user-add) shift; user_add "${1:-}"; exit $?;;
    create|--create|duplicate|--duplicate) shift; create_shader "${1:-}" "${2:-plasma.fs}"; exit $?;;
    replace|--replace) shift; replace_shader "${1:-}" "${2:-}"; exit $?;;
    remove|--remove) shift; remove_shader "${1:-}"; exit $?;;
    pick|--pick) choice=$(choose_gui);;
    *.fs) choice=$1;;
    *) choice=$(choose_gui);;
esac

[ -n "${choice:-}" ] || exit 0
apply_shader "$choice"
