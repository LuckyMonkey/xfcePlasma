#!/usr/bin/env bash
set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -r "$script_dir/../lib/xfce-plasma-common.sh" ]; then
    # shellcheck source=../lib/xfce-plasma-common.sh
    . "$script_dir/../lib/xfce-plasma-common.sh"
else
    # shellcheck source=/dev/null
    . "${XFCE_PLASMA_COMMON:-$HOME/.local/lib/xfce-plasma/xfce-plasma-common.sh}"
fi

RUNTIME=${WALLPAPER_RUNTIME:-$HOME/.local/lib/tie-dye-wallpaper}
SHADER_DIR=${WALLPAPER_SHADER_DIR:-$RUNTIME/shaders}
USER_SHADER_DIR=${WALLPAPER_USER_SHADER_DIR:-$XFCE_PLASMA_USER_SHADER_DIR}
ACTIVE_SHADER=${WALLPAPER_ACTIVE_SHADER:-$RUNTIME/shader.fs}
STATE_DIR=${WALLPAPER_STATE_DIR:-$XFCE_PLASMA_RENDERER_COMPAT_STATE_DIR}
STATE_FILE=$STATE_DIR/current-shader

ORDER=(
    tie-dye.fs
    motion-halftone.fs
    qr-cube-maze.fs
    sky-water-wave.fs
    kaleidoscope-tunnel.fs
    aurora-ribbons.fs
    plasma-lava.fs
    deep-ocean.fs
    isometric-city.fs
    trippy-houndstooth.fs
)

label_for() {
    case "$1" in
        tie-dye.fs) printf 'Tie Dye';;
        motion-halftone.fs) printf 'Motion Halftone';;
        kaleidoscope-tunnel.fs) printf 'Kaleidoscope Tunnel';;
        aurora-ribbons.fs) printf 'Aurora Ribbons';;
        plasma-lava.fs) printf 'Plasma Lava';;
        deep-ocean.fs) printf 'Deep Ocean';;
        *) basename "$1" .fs | sed 's/-/ /g; s/\b\(.\)/\u\1/g';;
    esac
}

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "Animated wallpaper" "$1" >/dev/null 2>&1 || true
}

shader_path() {
    local name=$1
    if [ -f "$SHADER_DIR/$name" ]; then
        printf '%s\n' "$SHADER_DIR/$name"
    elif [ -f "$USER_SHADER_DIR/$name" ]; then
        printf '%s\n' "$USER_SHADER_DIR/$name"
    else
        return 1
    fi
}

is_ordered() {
    local name=$1 item
    for item in "${ORDER[@]}"; do
        [ "$item" = "$name" ] && return 0
    done
    return 1
}

available() {
    local name
    for name in "${ORDER[@]}"; do
        shader_path "$name" >/dev/null 2>&1 && printf '%s\n' "$name"
    done
    {
        local directory
        for directory in "$SHADER_DIR" "$USER_SHADER_DIR"; do
            [ ! -d "$directory" ] || find "$directory" -maxdepth 1 -type f -name '*.fs' -printf '%f\n'
        done
        true
    } 2>/dev/null | sort -u | while IFS= read -r name; do
            is_ordered "$name" || printf '%s\n' "$name"
        done
}

current() {
    local saved active_hash name shader_hash source
    if [ -s "$STATE_FILE" ]; then
        saved=$(cat "$STATE_FILE")
        if shader_path "$saved" >/dev/null 2>&1; then
            printf '%s\n' "$saved"
            return
        fi
    fi

    if cmp -s "$ACTIVE_SHADER" "$SHADER_DIR/tie-dye.fs" 2>/dev/null; then
        printf 'tie-dye.fs\n'
        return
    fi

    active_hash=$(sha256sum "$ACTIVE_SHADER" 2>/dev/null | awk '{print $1}' || true)
    while IFS= read -r name; do
        source=$(shader_path "$name" || true)
        shader_hash=$(sha256sum "$source" 2>/dev/null | awk '{print $1}' || true)
        if [ -n "$active_hash" ] && [ "$active_hash" = "$shader_hash" ]; then
            printf '%s\n' "$name"
            return
        fi
    done < <(available)
    printf 'tie-dye.fs\n'
}

select_relative() {
    local direction=$1 cur count index i name
    local shaders=()
    cur=$(current)
    while IFS= read -r name; do
        shaders+=("$name")
    done < <(available)
    count=${#shaders[@]}
    [ "$count" -gt 0 ] || exit 1

    index=0
    for i in "${!shaders[@]}"; do
        [ "${shaders[$i]}" = "$cur" ] && index=$i
    done

    if [ "$direction" = next ]; then
        index=$(( (index + 1) % count ))
    else
        index=$(( index - 1 ))
        [ "$index" -ge 0 ] || index=$((count - 1))
    fi
    printf '%s\n' "${shaders[$index]}"
}

choose_gui() {
    local cur name label active
    local rows=()
    cur=$(current)
    while IFS= read -r name; do
        label=$(label_for "$name")
        if [ "$name" = "$cur" ]; then active=TRUE; else active=FALSE; fi
        rows+=("$active" "$label" "$name")
    done < <(available)

    if command -v zenity >/dev/null 2>&1; then
        zenity --list --radiolist --title="Animated wallpaper" --text="Choose wallpaper" \
            --column="" --column="Wallpaper" --column="File" --hide-column=3 --print-column=3 \
            "${rows[@]}" 2>/dev/null
    elif command -v rofi >/dev/null 2>&1; then
        available | while IFS= read -r name; do label_for "$name"; printf '\t%s\n' "$name"; done |
            rofi -dmenu -p "Wallpaper" | awk -F '\t' '{print $2}'
    else
        available
    fi
}

apply_shader() {
    local name=$1 src
    src=$(shader_path "$name" || true)
    [ -f "$src" ] || { notify "Missing shader: $name"; exit 1; }
    xfce_plasma_mkdirs
    mkdir -p "$STATE_DIR" "$(dirname "$ACTIVE_SHADER")"
    xfce_plasma_atomic_copy "$src" "$ACTIVE_SHADER"
    xfce_plasma_atomic_write "$STATE_FILE" "$name"
    notify "$(label_for "$name")"
}

user_add() {
    local src=$1 name
    [ -f "$src" ] || { printf 'Shader file not found: %s\n' "$src" >&2; return 1; }
    name=$(basename "$src")
    case "$name" in
        *.fs) ;;
        *) printf 'Shader must use the .fs extension\n' >&2; return 1;;
    esac
    [ ! -e "$SHADER_DIR/$name" ] || { printf 'Built-in shader already exists: %s\n' "$name" >&2; return 1; }
    xfce_plasma_atomic_copy "$src" "$USER_SHADER_DIR/$name"
    printf '%s\n' "$name"
}

case "${1:-pick}" in
    next|--next) choice=$(select_relative next);;
    prev|previous|--prev|--previous) choice=$(select_relative prev);;
    set|--set) shift; choice=${1:-};;
    list|--list) available; exit 0;;
    current|--current) current; exit 0;;
    user-add|--user-add) shift; user_add "${1:-}"; exit $?;;
    pick|--pick) choice=$(choose_gui);;
    *.fs) choice=$1;;
    *) choice=$(choose_gui);;
esac

[ -n "${choice:-}" ] || exit 0
apply_shader "$choice"
