#!/usr/bin/env bash
set -Eeuo pipefail

mode=${1:-pulse}
[ "$#" -eq 0 ] || shift
case "${1:-}" in
  black|white) shift ;;
esac
command=("$@")
service=${WALLPAPER_SERVICE:-tie-dye-wallpaper-mvp.service}
wait_seconds=${GAME_MODE_FADE_WAIT_SECONDS:-1}

request_native_fade_out() {
  local controller=${XFCE_PLASMA_BACKGROUND_COMMAND:-$HOME/.local/bin/xfce-plasma-background}
  if [ -x "$controller" ]; then
    "$controller" fade >/dev/null 2>&1 || true
    sleep "$wait_seconds"
  fi
}

run_command() {
  [ "${#command[@]}" -eq 0 ] || "${command[@]}"
}

case "$mode" in
  out)
    request_native_fade_out
    run_command
    ;;
  in)
    run_command
    systemctl --user start "$service"
    ;;
  pulse)
    request_native_fade_out
    run_command
    systemctl --user restart "$service"
    ;;
  *)
    printf "usage: %s {in|out|pulse} [black|white] [command ...]\n" "${0##*/}" >&2
    exit 2
    ;;
esac
