#!/usr/bin/env python3
import sys
import time

try:
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GLib
except Exception:
    sys.exit(0)

mode = sys.argv[1] if len(sys.argv) > 1 else 'pulse'
steps = 24
interval_ms = 16
hold_ms = 120

window = Gtk.Window(type=Gtk.WindowType.POPUP)
window.set_decorated(False)
window.set_app_paintable(True)
window.set_keep_above(True)
window.set_skip_taskbar_hint(True)
window.set_skip_pager_hint(True)
window.set_accept_focus(False)
window.set_focus_on_map(False)
window.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
window.fullscreen()

screen = Gdk.Screen.get_default()
visual = screen.get_rgba_visual() if screen else None
if visual:
    window.set_visual(visual)

alpha = 0.0
if mode == 'in':
    alpha = 1.0
elif mode == 'out':
    alpha = 0.0
elif mode == 'pulse':
    alpha = 0.0

phase = 'up' if mode in ('out', 'pulse') else 'down'
frame = 0

def draw(_widget, cr):
    cr.set_source_rgba(0, 0, 0, max(0.0, min(1.0, alpha)))
    cr.set_operator(1)  # CAIRO_OPERATOR_OVER
    cr.paint()
    return False

window.connect('draw', draw)
window.show_all()

def tick():
    global alpha, phase, frame
    frame += 1
    t = min(1.0, frame / steps)
    smooth = t * t * (3 - 2 * t)

    if phase == 'up':
        alpha = smooth
        if t >= 1.0:
            if mode == 'out':
                Gtk.main_quit()
                return False
            phase = 'hold'
            frame = 0
    elif phase == 'hold':
        if frame * interval_ms >= hold_ms:
            phase = 'down'
            frame = 0
    else:
        alpha = 1.0 - smooth
        if t >= 1.0:
            Gtk.main_quit()
            return False

    window.queue_draw()
    return True

GLib.timeout_add(interval_ms, tick)
GLib.timeout_add(2000, Gtk.main_quit)
Gtk.main()
