#!/bin/sh
# General game-mode desktop guard for Steam/Proton/Wine/native launchers.
# While a game is running, keep XFWM compositing disabled for smoother fullscreen.
# When the game exits, restore the full animated transparent desktop stack.

PATTERNS_FILE=${PATTERNS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/game-mode-guard/patterns}
LAUNCH_GRACE_SECONDS=${LAUNCH_GRACE_SECONDS:-8}
EXIT_GRACE_SECONDS=${EXIT_GRACE_SECONDS:-3}
POLL_SECONDS=${POLL_SECONDS:-1}
STATE_ROOT=${XDG_STATE_HOME:-$HOME/.local/state}/xfce-plasma
mkdir -p "$STATE_ROOT/logs"
LOG=${LOG:-$STATE_ROOT/logs/game-mode-guard.log}
RESTORE_LOG=${RESTORE_LOG:-$STATE_ROOT/logs/game-mode-desktop-restore.log}
WALLPAPER_UNIT=${WALLPAPER_UNIT:-tie-dye-wallpaper-mvp.service}
WALLPAPER_CHECK_SECONDS=${WALLPAPER_CHECK_SECONDS:-8}
IDLE_REPAIR_SECONDS=${IDLE_REPAIR_SECONDS:-30}
FULLSCREEN_MIN_WIDTH=${FULLSCREEN_MIN_WIDTH:-1200}
FULLSCREEN_MIN_HEIGHT=${FULLSCREEN_MIN_HEIGHT:-700}
GAME_MODE_STATE_DIR=${GAME_MODE_STATE_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/xfce-plasma/game-mode}

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
}

set_game_mode_state() {
    mkdir -p "$GAME_MODE_STATE_DIR"
}

clear_game_mode_state() {
    rmdir "$GAME_MODE_STATE_DIR" 2>/dev/null || true
}

process_game_running() {
    if [ ! -r "$PATTERNS_FILE" ]; then
        return 1
    fi

    while IFS= read -r pattern; do
        case "$pattern" in
            ''|'#'*) continue ;;
        esac
        if pgrep -af "$pattern" >/dev/null 2>&1; then
            log "game process matched: $pattern"
            return 0
        fi
    done < "$PATTERNS_FILE"

    return 1
}

fullscreen_window_present() {
    command -v xdotool >/dev/null 2>&1 || return 1
    command -v xprop >/dev/null 2>&1 || return 1

    for wid in $(xdotool search --onlyvisible --name '.*' 2>/dev/null); do
        state=$(xprop -id "$wid" _NET_WM_STATE 2>/dev/null || true)
        case "$state" in
            *_NET_WM_STATE_FULLSCREEN*) ;;
            *) continue ;;
        esac

        class=$(xprop -id "$wid" WM_CLASS 2>/dev/null || true)
        case "$class" in
            *xfce4-panel*|*Xfdesktop*|*xfdesktop*|*wrapper-2.0*|*Xfce-edge-center*|*Whisker*) continue ;;
        esac

        eval "$(xdotool getwindowgeometry --shell "$wid" 2>/dev/null || true)"
        if [ "${WIDTH:-0}" -ge "$FULLSCREEN_MIN_WIDTH" ] && [ "${HEIGHT:-0}" -ge "$FULLSCREEN_MIN_HEIGHT" ]; then
            log "fullscreen window matched: wid=$wid ${WIDTH}x${HEIGHT} $class"
            return 0
        fi
    done

    return 1
}

game_running() {
    process_game_running || fullscreen_window_present
}

fade_stop_wallpaper() {
    pids=$(pgrep -f '^([^[:space:]]*/)?tie-dye-wallpaper --wid ' || true)
    if [ -n "$pids" ]; then
        log "requesting native wallpaper fade out"
        kill -USR1 $pids 2>/dev/null || true
        waited=0
        while [ "$waited" -lt 3 ]; do
            if ! wallpaper_running; then
                return 0
            fi
            sleep 1
            waited=$((waited + 1))
        done
    fi
    systemctl --user stop "$WALLPAPER_UNIT" >/dev/null 2>&1 || true
}

fade_in_after_game() {
    # Fade-in is native: the renderer starts from black and raises its shader fade value.
    return 0
}

wallpaper_running() {
    systemctl --user is-active --quiet "$WALLPAPER_UNIT" &&
        pgrep -af '[/]usr/local/bin/xwinwrap .*tie-dye-wallpaper' >/dev/null 2>&1
}

ensure_wallpaper() {
    reason=$1
    log "ensuring animated wallpaper ($reason)"
    systemctl --user reset-failed "$WALLPAPER_UNIT" >/dev/null 2>&1 || true
    systemctl --user restart "$WALLPAPER_UNIT" >>"$RESTORE_LOG" 2>&1 || true

    waited=0
    while [ "$waited" -lt "$WALLPAPER_CHECK_SECONDS" ]; do
        if wallpaper_running; then
            log "animated wallpaper running"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    log "animated wallpaper still missing after ${WALLPAPER_CHECK_SECONDS}s"
    return 1
}

enter_game_mode() {
    if fullscreen_window_present; then
        log "fullscreen detected; entering game mode immediately"
    else
        log "game process detected; waiting ${LAUNCH_GRACE_SECONDS}s before disabling compositor"
        sleep "$LAUNCH_GRACE_SECONDS"
        if ! game_running; then
            log "game exited during launch grace; leaving desktop unchanged"
            return 1
        fi
    fi

    set_game_mode_state
    fade_stop_wallpaper
    systemctl --user stop picom-effects.service >/dev/null 2>&1 || true
    sleep 1
    xfconf-query -c xfwm4 -p /general/use_compositing -s false >/dev/null 2>&1 || true
    log "game mode active"
    return 0
}

restore_desktop() {
    log "game exited; waiting ${EXIT_GRACE_SECONDS}s before restore"
    sleep "$EXIT_GRACE_SECONDS"
    if game_running; then
        log "another game process appeared during exit grace; staying in game mode"
        return 1
    fi

    clear_game_mode_state
    "$HOME/.local/bin/start-transparent-xfdesktop-session" >"$RESTORE_LOG" 2>&1
    status=$?
    if [ "$status" -eq 0 ] && ensure_wallpaper "post-game restore"; then
        fade_in_after_game
        log "desktop restored"
    else
        log "desktop restore failed with status $status; see $RESTORE_LOG"
        ensure_wallpaper "restore fallback" || true
    fi
    wallpaper_running
}

in_game_mode=false
last_idle_repair=0
clear_game_mode_state
trap clear_game_mode_state EXIT
trap 'clear_game_mode_state; exit 0' HUP INT TERM
log "game-mode guard started"
while :; do
    if game_running; then
        if [ "$in_game_mode" = false ]; then
            if enter_game_mode; then
                in_game_mode=true
            fi
        fi
    elif [ "$in_game_mode" = true ]; then
        if restore_desktop; then
            in_game_mode=false
        fi
    elif ! wallpaper_running; then
        now=$(date +%s)
        if [ $((now - last_idle_repair)) -ge "$IDLE_REPAIR_SECONDS" ]; then
            last_idle_repair=$now
            ensure_wallpaper "idle repair" || true
        fi
    fi
    sleep "$POLL_SECONDS"
done
