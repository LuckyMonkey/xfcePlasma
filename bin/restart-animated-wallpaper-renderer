#!/usr/bin/env bash
set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -r "$script_dir/../lib/xfce-plasma-common.sh" ]; then
  . "$script_dir/../lib/xfce-plasma-common.sh"
else
  . "${XFCE_PLASMA_COMMON:-$HOME/.local/lib/xfce-plasma/xfce-plasma-common.sh}"
fi
xfce_plasma_export_session_env
xfce_plasma_mkdirs
systemctl --user restart tie-dye-wallpaper-mvp.service >"$XFCE_PLASMA_LOG_DIR/tie-dye-wallpaper.log" 2>&1
