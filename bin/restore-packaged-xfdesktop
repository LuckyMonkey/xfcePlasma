#!/usr/bin/env bash
set -euo pipefail
export HOME=/home/freezer
export USER=freezer
export LOGNAME=freezer
export DISPLAY=${DISPLAY:-:0.0}
export XAUTHORITY=/home/freezer/.Xauthority
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
/home/freezer/.local/bin/stop-custom-xfdesktop || true
if ! pgrep -x xfdesktop >/dev/null 2>&1; then
  LOG_DIR="/home/freezer/.cache/xfcePlasma/logs"
  mkdir -p "$LOG_DIR"
  LOG="$LOG_DIR/restore-packaged-xfdesktop-$(date +%Y%m%d-%H%M%S).log"
  nohup /usr/bin/xfdesktop --disable-wm-check >"$LOG" 2>&1 &
  echo "$!" > /tmp/xfdesktop-packaged.pid
  echo "Restored packaged xfdesktop PID $! log $LOG"
else
  echo "xfdesktop already running"
fi
