#!/usr/bin/env bash
set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -r "$script_dir/../lib/xfce-plasma-common.sh" ]; then
  . "$script_dir/../lib/xfce-plasma-common.sh"
else
  . "${XFCE_PLASMA_COMMON:-$HOME/.local/lib/xfce-plasma/xfce-plasma-common.sh}"
fi
xfce_plasma_export_session_env
xfce_plasma_mkdirs
"$XFCE_PLASMA_BIN_DIR/stop-custom-xfdesktop" || true
if ! pgrep -x xfdesktop >/dev/null 2>&1; then
  log="$XFCE_PLASMA_LOG_DIR/restore-packaged-xfdesktop-$(date +%Y%m%d-%H%M%S).log"
  nohup /usr/bin/xfdesktop --disable-wm-check >"$log" 2>&1 &
  xfce_plasma_atomic_write "$XFCE_PLASMA_RUN_DIR/xfdesktop-packaged.pid" "$!"
  printf "Restored packaged xfdesktop PID %s log %s\n" "$!" "$log"
else
  printf "xfdesktop already running\n"
fi
