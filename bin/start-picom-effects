#!/usr/bin/env bash
set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -r "$script_dir/../lib/xfce-plasma-common.sh" ]; then
  . "$script_dir/../lib/xfce-plasma-common.sh"
else
  . "${XFCE_PLASMA_COMMON:-$HOME/.local/lib/xfce-plasma/xfce-plasma-common.sh}"
fi
xfce_plasma_export_session_env
xfce_plasma_mkdirs
export NO_AT_BRIDGE=1
# XFWM remains the window manager; only its built-in compositor is replaced.
cleanup() {
    xfconf-query -c xfwm4 -p /general/use_compositing -s true >/dev/null 2>&1
}
trap cleanup EXIT HUP INT TERM

xfconf-query -c xfwm4 -p /general/use_compositing -s false
sleep 2
setsid "$XFCE_PLASMA_BIN_DIR/raise-floating-whisker" >"$XFCE_PLASMA_LOG_DIR/raise-floating-whisker.log" 2>&1 &
"$XFCE_PLASMA_BIN_DIR/picom" --config "${PICOM_CONFIG:-$XFCE_PLASMA_XDG_CONFIG_HOME/picom/picom.conf}"
status=$?
xfconf-query -c xfwm4 -p /general/use_compositing -s true
exit "$status"
