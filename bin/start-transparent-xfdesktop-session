#!/usr/bin/env bash
set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -r "$script_dir/../lib/xfce-plasma-common.sh" ]; then
  . "$script_dir/../lib/xfce-plasma-common.sh"
else
  . "${XFCE_PLASMA_COMMON:-$HOME/.local/lib/xfce-plasma/xfce-plasma-common.sh}"
fi
xfce_plasma_export_session_env
xfce_plasma_mkdirs
systemctl --user import-environment DISPLAY XAUTHORITY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS >/dev/null 2>&1 || true
export NO_AT_BRIDGE=1

LOG_DIR="$XFCE_PLASMA_LOG_DIR"
mkdir -p "$LOG_DIR"

xfconf-query -c xfwm4 -p /general/use_compositing -s false
if ! systemctl --user is-active --quiet picom-effects.service; then
  systemctl --user stop picom-effects.service >/dev/null 2>&1 || true
  systemctl --user reset-failed picom-effects.service >/dev/null 2>&1 || true
  systemd-run --user --unit=picom-effects --collect "$XFCE_PLASMA_BIN_DIR/start-picom-effects" >/dev/null
  sleep 2
fi

systemctl --user daemon-reload
xfconf-query -c xfce4-desktop -p /desktop-icons/style -s 2
xfconf-query -c xfce4-desktop -p /backdrop/transparent-background -n -t bool -s true
xfce_plasma_restart_desktop_stack tie-dye-wallpaper-mvp.service xfdesktop-transparent.service
