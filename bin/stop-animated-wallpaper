#!/usr/bin/env bash
set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -x "$script_dir/xfce-plasma-background" ]; then
  "$script_dir/xfce-plasma-background" stop 2>/dev/null || true
else
  "$HOME/.local/bin/xfce-plasma-background" stop 2>/dev/null || true
fi
notify-send "Animated wallpaper stopped" "XFCE desktop remains active." 2>/dev/null || true
