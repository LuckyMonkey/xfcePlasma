#!/usr/bin/env bash
set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -r "$script_dir/../lib/xfce-plasma-common.sh" ]; then
  . "$script_dir/../lib/xfce-plasma-common.sh"
else
  . "${XFCE_PLASMA_COMMON:-$HOME/.local/lib/xfce-plasma/xfce-plasma-common.sh}"
fi
xfce_plasma_export_session_env
xfce_plasma_mkdirs
sleep "${TIE_DYE_START_DELAY:-8}"
if [ -x "$script_dir/xfce-plasma-background" ]; then
  "$script_dir/xfce-plasma-background" start >"$XFCE_PLASMA_LOG_DIR/tie-dye-wallpaper.log" 2>&1
else
  "$XFCE_PLASMA_BIN_DIR/xfce-plasma-background" start >"$XFCE_PLASMA_LOG_DIR/tie-dye-wallpaper.log" 2>&1
fi
