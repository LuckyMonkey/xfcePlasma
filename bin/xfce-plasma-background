#!/usr/bin/env bash
set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -r "$script_dir/../lib/xfce-plasma-common.sh" ]; then
  . "$script_dir/../lib/xfce-plasma-common.sh"
  . "$script_dir/../lib/xfce-plasma-sources.sh"
  . "$script_dir/../lib/xfce-plasma-performance.sh"
else
  . "${XFCE_PLASMA_COMMON:-$HOME/.local/lib/xfce-plasma/xfce-plasma-common.sh}"
  . "${XFCE_PLASMA_SOURCES:-$HOME/.local/lib/xfce-plasma/xfce-plasma-sources.sh}"
  . "${XFCE_PLASMA_PERFORMANCE:-$HOME/.local/lib/xfce-plasma/xfce-plasma-performance.sh}"
fi
xfce_plasma_export_session_env
xfce_plasma_mkdirs

BACKGROUND_UNIT=${XFCE_PLASMA_BACKGROUND_UNIT:-tie-dye-wallpaper-mvp.service}
XWINWRAP=${XFCE_PLASMA_XWINWRAP:-$(command -v xwinwrap 2>/dev/null || true)}
RENDERER=${XFCE_PLASMA_RENDERER:-$XFCE_PLASMA_RENDERER_DIR/tie-dye-wallpaper}
MPV=${XFCE_PLASMA_MPV:-$(command -v mpv 2>/dev/null || true)}
VLC=${XFCE_PLASMA_VLC:-$(command -v cvlc 2>/dev/null || command -v vlc 2>/dev/null || true)}
SELF=$(readlink -f "$0")

picker_path() {
  if [ -x "$script_dir/animated-wallpaper-picker" ]; then printf '%s\n' "$script_dir/animated-wallpaper-picker"
  else printf '%s\n' "$XFCE_PLASMA_BIN_DIR/animated-wallpaper-picker"; fi
}

write_backend_state() {
  local state=$1 type=$2 id=$3 backend=$4 pid=${5:-0} window=${6:-} data
  data=$(printf 'state=%s\ntype=%s\nid=%s\nbackend=%s\nbackend_pid=%s\nwindow_id=%s\nstarted=%s\n' \
    "$state" "$type" "$id" "$backend" "$pid" "$window" "$(date -Is)")
  xfce_plasma_atomic_write "$XFCE_PLASMA_BACKEND_STATE_FILE" "$data"
  xfce_plasma_atomic_write "$XFCE_PLASMA_BACKEND_STATUS_FILE" "$state"
}

cleanup_runtime() {
  rm -f -- "$XFCE_PLASMA_BACKEND_STATE_FILE" "$XFCE_PLASMA_BACKEND_STATUS_FILE" \
    "$XFCE_PLASMA_RUN_DIR/mpv.sock"
}

active_source() {
  xfce_plasma_source_migrate
  xfce_plasma_source_validate_selector "$XFCE_PLASMA_ACTIVE_SOURCE_FILE"
  xfce_plasma_source_active_config >/dev/null
}

active_config() {
  xfce_plasma_source_active_config
}

set_transparency() {
  local value=$1
  command -v xfconf-query >/dev/null 2>&1 || return 0
  xfconf-query -c xfce4-desktop -p /backdrop/transparent-background -n -t bool -s "$value" >/dev/null 2>&1 || true
}

run_background() {
  local type id backend config path requested_backend
  active_source
  type=$(xfce_plasma_source_active_type)
  id=$(xfce_plasma_source_active_id)
  config=$(active_config)
  case "$type" in
    shader) backend=raylib; set_transparency true ;;
    video)
      path=$(xfce_plasma_source_value "$config" path)
      if [ ! -f "$path" ] || [ ! -r "$path" ]; then
        set_transparency false
        write_backend_state error video "$id" unavailable 0 ""
        printf 'Video source is missing or unreadable: %s\n' "$path" >&2
        return 1
      fi
      requested_backend=$(xfce_plasma_source_value "$config" backend automatic)
      backend=$(select_media_backend "$requested_backend") || { set_transparency false; return 1; }
      set_transparency true
      ;;
    fallback)
      set_transparency false
      write_backend_state running fallback "$id" static "$$" ""
      exec sleep infinity
      ;;
    *) printf 'Source type %s is not implemented by this build\n' "$type" >&2; return 1 ;;
  esac
  [ -n "$XWINWRAP" ] && [ -x "$XWINWRAP" ] || { printf 'xwinwrap is unavailable\n' >&2; return 1; }
  xfce_plasma_performance_export
  write_backend_state starting "$type" "$id" "$backend" 0 ""
  exec "$XWINWRAP" -b -s -fs -st -sp -ni -nf -ov -fdt -un -- "$SELF" backend-run WID
}

backend_run() {
  local window=$1 type id shader_file picker digits config backend path loop muted fit speed
  local -a player
  case "$window" in
    0x*|0X*) digits=${window:2}; case "$digits" in ''|*[!0-9A-Fa-f]*) printf 'Invalid X11 window ID\n' >&2; return 2 ;; esac ;;
    ''|*[!0-9]*) printf 'Invalid X11 window ID\n' >&2; return 2 ;;
  esac
  active_source
  type=$(xfce_plasma_source_active_type)
  id=$(xfce_plasma_source_active_id)
  config=$(active_config)
  case "$type" in
    shader)
      [ -x "$RENDERER" ] || { printf 'Shader renderer is unavailable: %s\n' "$RENDERER" >&2; return 1; }
      shader_file=$id.fs
      picker=$(picker_path)
      "$picker" set "$shader_file" >/dev/null
      write_backend_state running shader "$id" raylib "$$" "$window"
      cd "$XFCE_PLASMA_RENDERER_DIR"
      exec "$RENDERER" --wid "$window"
      ;;
    video)
      backend=$(select_media_backend "$(xfce_plasma_source_value "$config" backend automatic)")
      [ "$backend" = mpv ] || { printf 'VLC embedding is detected but remains experimental in this build\n' >&2; return 1; }
      path=$(xfce_plasma_source_value "$config" path)
      [ -f "$path" ] && [ -r "$path" ] || { printf 'Video source is missing or unreadable: %s\n' "$path" >&2; return 1; }
      loop=$(xfce_plasma_source_value "$config" loop true)
      muted=$(xfce_plasma_source_value "$config" muted true)
      fit=$(xfce_plasma_source_value "$config" fit cover)
      speed=$(xfce_plasma_source_value "$config" speed 1.0)
      player=("$MPV" "--wid=$window" --no-osc --no-osd-bar --no-input-default-bindings
        --no-input-cursor --no-border --keep-open=yes --hwdec=auto-safe
        --stop-screensaver=no "--input-ipc-server=$XFCE_PLASMA_RUN_DIR/mpv.sock"
        "--speed=$speed")
      if [ "$loop" = true ]; then player+=(--loop-file=inf); else player+=(--loop-file=no); fi
      if [ "$muted" = true ]; then player+=(--no-audio); else player+=(--audio=auto); fi
      case "$fit" in
        cover) player+=(--keepaspect=yes --panscan=1.0) ;;
        contain) player+=(--keepaspect=yes --panscan=0) ;;
        stretch) player+=(--keepaspect=no --panscan=0) ;;
      esac
      player+=(-- "$path")
      write_backend_state running video "$id" mpv "$$" "$window"
      exec "${player[@]}"
      ;;
    *) printf 'Unsupported backend source type: %s\n' "$type" >&2; return 1 ;;
  esac
}

select_media_backend() {
  local requested=${1:-automatic}
  case "$requested" in
    automatic)
      if [ -n "$MPV" ] && [ -x "$MPV" ]; then printf 'mpv\n'
      elif [ -n "$VLC" ] && [ -x "$VLC" ]; then printf 'vlc\n'
      else printf 'No supported media backend is installed; install mpv for video backgrounds.\n' >&2; return 1
      fi
      ;;
    mpv) [ -n "$MPV" ] && [ -x "$MPV" ] || { printf 'The selected mpv backend is unavailable.\n' >&2; return 1; }; printf 'mpv\n' ;;
    vlc) [ -n "$VLC" ] && [ -x "$VLC" ] || { printf 'The selected VLC backend is unavailable.\n' >&2; return 1; }; printf 'vlc\n' ;;
    *) printf 'Unknown media backend: %s\n' "$requested" >&2; return 2 ;;
  esac
}

unique_source_id() {
  local base=$1 candidate=$1 suffix=2
  while [ -e "$XFCE_PLASMA_SOURCE_DIR/$candidate.source" ]; do
    candidate=$base-$suffix
    suffix=$((suffix + 1))
  done
  printf '%s\n' "$candidate"
}

add_video() {
  local requested=$1 requested_id=${2:-} path name id data
  path=$(realpath -e -- "$requested" 2>/dev/null) || { printf 'Video file not found: %s\n' "$requested" >&2; return 1; }
  [ -f "$path" ] && [ -r "$path" ] || { printf 'Video file is unreadable: %s\n' "$path" >&2; return 1; }
  name=$(basename "$path")
  name=${name%.*}
  if [ -n "$requested_id" ]; then
    id=$requested_id
    xfce_plasma_source_valid_id "$id" || { printf 'Invalid source ID: %s\n' "$id" >&2; return 2; }
    [ ! -e "$XFCE_PLASMA_SOURCE_DIR/$id.source" ] || { printf 'Source already exists: %s\n' "$id" >&2; return 1; }
  else
    id=$(unique_source_id "$(xfce_plasma_source_slug "$name")")
  fi
  data=$(printf 'type=video\nid=%s\ndisplay_name=%s\ncategory=Video\ndescription=Local looping video.\norigin=local\npath=%s\nloop=true\nmuted=true\nfit=cover\nspeed=1.0\nbackend=automatic\ncapabilities=supports-loop,supports-audio,supports-fit,supports-pause\n' \
    "$id" "$name" "$path")
  xfce_plasma_source_write_definition "$id" "$data" >/dev/null
  printf '%s\n' "$id"
}

select_video() {
  local path=$1 requested_id=${2:-} id
  select_media_backend automatic >/dev/null
  id=$(add_video "$path" "$requested_id")
  xfce_plasma_source_write_active video "$id"
  systemctl --user restart "$BACKGROUND_UNIT"
  printf '%s\n' "$id"
}

activate_source() {
  local id=$1 definition type
  definition=$(xfce_plasma_source_definition_file "$id")
  xfce_plasma_source_validate_file "$definition"
  type=$(xfce_plasma_source_value "$definition" type)
  xfce_plasma_source_write_active "$type" "$id"
  systemctl --user restart "$BACKGROUND_UNIT"
}

clean_catalog_field() {
  printf '%s' "$1" | tr '\t\r\n' '   '
}

source_catalog() {
  local picker line id file type display category description author thumbnail origin order key
  picker=$(picker_path)
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    IFS=$'\t' read -r file id display category description author thumbnail origin order <<< "$line"
    key=shader:$id
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\tShader\t%s\n' \
      "$key" "$id" "$display" "$category" "$description" "$author" "$thumbnail" "$origin" "$order" "$file"
  done < <("$picker" catalog)

  for file in "$XFCE_PLASMA_SOURCE_DIR"/*.source; do
    [ -e "$file" ] || continue
    xfce_plasma_source_validate_file "$file" >/dev/null 2>&1 || continue
    type=$(xfce_plasma_source_value "$file" type)
    case "$type" in video|stream) ;; *) continue ;; esac
    id=$(xfce_plasma_source_value "$file" id)
    display=$(xfce_plasma_source_value "$file" display_name "$id")
    category=$(xfce_plasma_source_value "$file" category "${type^}")
    description=$(xfce_plasma_source_value "$file" description "Local ${type} source.")
    author=$(xfce_plasma_source_value "$file" author User)
    thumbnail=$(xfce_plasma_source_value "$file" thumbnail "$XFCE_PLASMA_THUMBNAIL_DIR/fallback.png")
    [ -r "$thumbnail" ] || thumbnail=$XFCE_PLASMA_THUMBNAIL_DIR/fallback.png
    origin=$(xfce_plasma_source_value "$file" origin local)
    order=$(xfce_plasma_source_value "$file" sort_order 5000)
    case "$order" in ''|*[!0-9]*) order=5000 ;; esac
    key=$type:$id
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$(clean_catalog_field "$key")" "$(clean_catalog_field "$id")" \
      "$(clean_catalog_field "$display")" "$(clean_catalog_field "$category")" \
      "$(clean_catalog_field "$description")" "$(clean_catalog_field "$author")" \
      "$(clean_catalog_field "$thumbnail")" "$(clean_catalog_field "$origin")" "$order" \
      "${type^}" "$id"
  done
}

current_source_key() {
  active_source
  printf '%s:%s\n' "$(xfce_plasma_source_active_type)" "$(xfce_plasma_source_active_id)"
}

use_source_key() {
  local key=$1 type=${1%%:*} id=${1#*:}
  [ "$key" != "$id" ] || { printf 'Source key must include its type\n' >&2; return 2; }
  case "$type" in
    shader) select_shader "$id" ;;
    video|stream) activate_source "$id" ;;
    fallback) select_fallback ;;
    *) printf 'Unknown source type: %s\n' "$type" >&2; return 2 ;;
  esac
}

select_relative_source() {
  local direction=$1 current index=0 count position
  local -a keys=()
  current=$(current_source_key)
  mapfile -t keys < <(source_catalog | cut -f1)
  count=${#keys[@]}
  [ "$count" -gt 0 ] || return 1
  for position in "${!keys[@]}"; do [ "${keys[$position]}" = "$current" ] && index=$position; done
  if [ "$direction" = next ]; then index=$(((index + 1) % count))
  else index=$((index - 1)); [ "$index" -ge 0 ] || index=$((count - 1)); fi
  use_source_key "${keys[$index]}"
}

select_shader() {
  local requested=$1 id previous_type picker
  id=$(xfce_plasma_source_canonical_shader_id "$requested")
  xfce_plasma_source_valid_id "$id" || { printf 'Invalid shader source: %s\n' "$requested" >&2; return 2; }
  previous_type=$(xfce_plasma_source_active_type 2>/dev/null || printf shader)
  picker=$(picker_path)
  "$picker" set "$id.fs"
  xfce_plasma_source_write_active shader "$id"
  if systemctl --user is-active --quiet "$BACKGROUND_UNIT"; then
    [ "$previous_type" = shader ] || systemctl --user restart "$BACKGROUND_UNIT"
  else
    systemctl --user start "$BACKGROUND_UNIT"
  fi
}

select_fallback() {
  xfce_plasma_source_write_active fallback static
  systemctl --user restart "$BACKGROUND_UNIT"
}

backend_state_value() {
  local key=$1 fallback=${2:-} value
  value=$(xfce_plasma_config_get "$XFCE_PLASMA_BACKEND_STATE_FILE" "$key" 2>/dev/null || true)
  if [ -n "$value" ]; then printf '%s\n' "$value"; else printf '%s\n' "$fallback"; fi
}

backend_pid() {
  backend_state_value backend_pid 0
}

signal_backend() {
  local signal=$1 pid cmdline
  pid=$(backend_pid)
  case "$pid" in ''|0|*[!0-9]*) return 1 ;; esac
  [ -r "/proc/$pid/cmdline" ] || return 1
  cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline")
  case "$cmdline" in
    *tie-dye-wallpaper*|*xfce-plasma-renderer*) kill -"$signal" "$pid" ;;
    *) printf 'Refusing to signal unverified backend PID %s\n' "$pid" >&2; return 1 ;;
  esac
}

status_report() {
  local service type id backend state pid window mode tier fps scale
  active_source
  service=$(systemctl --user is-active "$BACKGROUND_UNIT" 2>/dev/null || true)
  type=$(xfce_plasma_source_active_type)
  id=$(xfce_plasma_source_active_id)
  backend=$(backend_state_value backend unavailable)
  state=$(cat "$XFCE_PLASMA_BACKEND_STATUS_FILE" 2>/dev/null || printf '%s' "$service")
  pid=$(backend_state_value backend_pid 0)
  window=$(backend_state_value window_id '')
  mode=$(xfce_plasma_performance_mode)
  tier=$(xfce_plasma_config_get "$XFCE_PLASMA_PERFORMANCE_PROFILE_FILE" tier 2>/dev/null || printf undetected)
  fps=$(xfce_plasma_config_get "$XFCE_PLASMA_PERFORMANCE_PROFILE_FILE" fps 2>/dev/null || printf unknown)
  scale=$(xfce_plasma_config_get "$XFCE_PLASMA_PERFORMANCE_PROFILE_FILE" render_scale 2>/dev/null || printf unknown)
  printf 'service=%s\nsource_type=%s\nsource_id=%s\nbackend=%s\nstate=%s\nbackend_pid=%s\nwindow_id=%s\n' \
    "$service" "$type" "$id" "$backend" "$state" "$pid" "$window"
  printf 'performance_mode=%s\nperformance_tier=%s\nfps=%s\nrender_scale=%s\n' "$mode" "$tier" "$fps" "$scale"
}

performance_command() {
  local action=${1:-status}
  case "${action,,}" in
    status) xfce_plasma_performance_detect ;;
    redetect) xfce_plasma_performance_detect true ;;
    automatic|low|balanced|high)
      xfce_plasma_performance_set_mode "$action"
      xfce_plasma_performance_detect true
      systemctl --user try-restart "$BACKGROUND_UNIT" >/dev/null 2>&1 || true
      ;;
    *) printf 'usage: xfce-plasma-background performance [status|redetect|automatic|low|balanced|high]\n' >&2; return 2 ;;
  esac
}

case "${1:-status}" in
  start) active_source; systemctl --user start "$BACKGROUND_UNIT" ;;
  stop) systemctl --user stop "$BACKGROUND_UNIT"; cleanup_runtime ;;
  restart) active_source; systemctl --user restart "$BACKGROUND_UNIT" ;;
  status) status_report ;;
  pause)
    systemctl --user kill --kill-whom=all --signal=STOP "$BACKGROUND_UNIT"
    xfce_plasma_atomic_write "$XFCE_PLASMA_BACKEND_STATUS_FILE" paused
    ;;
  resume)
    systemctl --user kill --kill-whom=all --signal=CONT "$BACKGROUND_UNIT"
    xfce_plasma_atomic_write "$XFCE_PLASMA_BACKEND_STATUS_FILE" running
    ;;
  reload) systemctl --user reload-or-restart "$BACKGROUND_UNIT" ;;
  shader) [ "$#" -ge 2 ] || { printf 'shader requires a source ID or filename\n' >&2; exit 2; }; select_shader "$2" ;;
  video) [ "$#" -ge 2 ] || { printf 'video requires a local file path\n' >&2; exit 2; }; select_video "$2" "${3:-}" ;;
  add-video) [ "$#" -ge 3 ] || { printf 'add-video requires an ID and local file path\n' >&2; exit 2; }; add_video "$3" "$2" ;;
  activate) [ "$#" -eq 2 ] || exit 2; activate_source "$2" ;;
  use) [ "$#" -eq 2 ] || exit 2; use_source_key "$2" ;;
  next) select_relative_source next ;;
  prev|previous) select_relative_source previous ;;
  performance) performance_command "${2:-status}" ;;
  current) current_source_key ;;
  catalog) source_catalog ;;
  detect-backend) select_media_backend "${2:-automatic}" ;;
  fallback) select_fallback ;;
  fade) signal_backend USR1 ;;
  migrate) xfce_plasma_source_migrate; cat "$XFCE_PLASMA_ACTIVE_SOURCE_FILE" ;;
  run) run_background ;;
  backend-run) [ "$#" -eq 2 ] || exit 2; backend_run "$2" ;;
  cleanup) cleanup_runtime ;;
  *) printf 'usage: %s {start|stop|restart|status|pause|resume|reload|shader SOURCE|video PATH [ID]|activate ID|fallback|performance [MODE]}\n' "${0##*/}" >&2; exit 2 ;;
esac
