@@ -1793,0 +1915,49 @@ xfce_desktop_set_single_workspace_number(XfceDesktop *desktop,
+static void
+xfce_desktop_set_transparent_background(XfceDesktop *desktop,
+                                        gboolean transparent_background)
+{
+    g_return_if_fail(XFCE_IS_DESKTOP(desktop));
+
+    transparent_background = !!transparent_background;
+
+    if(transparent_background == desktop->priv->transparent_background)
+        return;
+
+    desktop->priv->transparent_background = transparent_background;
+
+    XF_DEBUG("transparent_background now %s",
+             transparent_background ? "TRUE" : "FALSE");
+
+    if(gtk_widget_get_realized(GTK_WIDGET(desktop))) {
+        if(transparent_background) {
+            GdkVisual *visual = gtk_widget_get_visual(GTK_WIDGET(desktop));
+
+            if(visual == NULL || gdk_visual_get_depth(visual) < 32) {
+                g_warning("transparent-background was enabled after realization; restart xfdesktop to obtain an RGBA visual");
+            }
+
+            if(desktop->priv->bg_surface != NULL)
+                xfce_desktop_clear_surface(desktop->priv->bg_surface, NULL);
+
+            if(desktop->priv->icon_view != NULL) {
+                g_object_set_data(G_OBJECT(desktop->priv->icon_view),
+                                  "xfdesktop-transparent-background",
+                                  GINT_TO_POINTER(TRUE));
+            }
+
+            xfce_desktop_clear_opaque_region(desktop);
+        } else {
+            if(desktop->priv->icon_view != NULL)
+                g_object_set_data(G_OBJECT(desktop->priv->icon_view),
+                                  "xfdesktop-transparent-background", NULL);
+
+            if(desktop->priv->bg_surface != NULL) {
+                cairo_surface_destroy(desktop->priv->bg_surface);
+                desktop->priv->bg_surface = NULL;
+            }
+        }
+
+        screen_size_changed_cb(desktop->priv->gscreen, desktop);
+    }
+}
