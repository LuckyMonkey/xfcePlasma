+static void
+xfce_desktop_clear_surface(cairo_surface_t *surface,
+                           const cairo_region_t *clip_region)
+{
+    cairo_t *cr;
+
+    if(surface == NULL)
+        return;
+
+    cr = cairo_create(surface);
+    cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+    cairo_set_source_rgba(cr, 0.0, 0.0, 0.0, 0.0);
+
+    if(clip_region != NULL) {
+        gdk_cairo_region(cr, clip_region);
+        cairo_clip(cr);
+    }
+
+    cairo_paint(cr);
+    cairo_destroy(cr);
+}
+
+static void
+xfce_desktop_clear_opaque_region(XfceDesktop *desktop)
+{
+    GdkWindow *window;
+    Display *xdisplay;
+    Atom atom;
+
+    g_return_if_fail(XFCE_IS_DESKTOP(desktop));
+
+    if(!gtk_widget_get_realized(GTK_WIDGET(desktop)))
+        return;
+
+    window = gtk_widget_get_window(GTK_WIDGET(desktop));
+    if(window == NULL)
+        return;
+
+    xdisplay = GDK_WINDOW_XDISPLAY(window);
+    atom = XInternAtom(xdisplay, "_NET_WM_OPAQUE_REGION", False);
+    XDeleteProperty(xdisplay, GDK_WINDOW_XID(window), atom);
+    XFlush(xdisplay);
+}
