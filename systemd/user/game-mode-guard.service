[Unit]
Description=xfcePlasma game mode guard
After=graphical-session.target dbus.service
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/game-mode-guard
KillMode=control-group
TimeoutStopSec=5
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
