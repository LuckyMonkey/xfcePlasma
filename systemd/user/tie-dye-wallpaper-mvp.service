[Unit]
Description=Animated wallpaper renderer behind transparent xfdesktop
After=graphical-session.target xfce4-session.target dbus.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/tie-dye-wallpaper
Environment=__GL_YIELD=USLEEP
ExecStartPre=-/usr/bin/pkill -x xwinwrap
ExecStartPre=/usr/bin/sleep 1
ExecStart=/usr/bin/nice -n 15 /usr/bin/ionice -c 3 /usr/local/bin/xwinwrap -b -s -fs -st -sp -ni -nf -ov -fdt -un -- %h/.local/lib/tie-dye-wallpaper/tie-dye-wallpaper --wid WID
Restart=on-failure
RestartSec=2
