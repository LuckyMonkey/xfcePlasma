[Unit]
Description=xfcePlasma animated background session
After=graphical-session.target xfce4-session.target dbus.service
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
Environment=__GL_YIELD=USLEEP
ExecStart=/usr/bin/nice -n 15 /usr/bin/ionice -c 3 %h/.local/bin/xfce-plasma-background run
ExecStopPost=%h/.local/bin/xfce-plasma-background cleanup
KillMode=control-group
TimeoutStopSec=5
