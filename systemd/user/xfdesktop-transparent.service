[Unit]
Description=xfcePlasma transparent xfdesktop icon layer
After=graphical-session.target xfce4-session.target dbus.service tie-dye-wallpaper-mvp.service
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/start-transparent-xfdesktop-session
KillMode=control-group
TimeoutStopSec=5
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
